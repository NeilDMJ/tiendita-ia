# Copia este archivo como .env (no se sube al repo)
# IP de la laptop/servidor del back en la red local (el teléfono no entiende "localhost")
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
# 1 = datos sintéticos (MOCK, sin backend). 0 = backend real (ver ../back/README.md);
# el modelo (NIM nube u Ollama local) se elige en back/.env, no aquí
EXPO_PUBLIC_USE_MOCKS=1
# 1 = la cámara usa el modelo de visión real del back (/vision/*) aunque USE_MOCKS=1
EXPO_PUBLIC_VISION_REAL=0
# 1 = el chat usa el asistente bancario real (/asistente/mensaje) aunque USE_MOCKS=1
EXPO_PUBLIC_ASISTENTE_REAL=0
# Solo con mocks: escenario de la cámara para probar errores en la demo
# ok (default) | vacio | ilegible | lento
EXPO_PUBLIC_MOCK_VISION=ok
# Simulación de pago digital: ok (pago recibido) | falla (pago no recibido)
EXPO_PUBLIC_MOCK_PAGO=ok
# Solo con mocks: respuestas del asistente
# ok (default) | lento (12 s: muestra "Está tardando…") | falla (error del servidor)
EXPO_PUBLIC_MOCK_ASISTENTE=ok
# Número de WhatsApp de soporte (solo dígitos con lada). NECESARIO PARA LA DEMO: sin él se oculta
# "Escribir a soporte" en la respuesta "No pude resolverlo". Este es FICTICIO: pon el del equipo en tu .env.
EXPO_PUBLIC_SOPORTE_WHATSAPP=5215500000000
