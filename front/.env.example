# Copia este archivo como .env (no se sube al repo)
# IP de la laptop/servidor del back en la red local (el teléfono no entiende "localhost")
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
# 1 = datos sintéticos (MOCK, sin backend). 0 = backend real (ver ../back/README.md);
# el modelo (NIM nube u Ollama local) se elige en back/.env, no aquí
EXPO_PUBLIC_USE_MOCKS=1
