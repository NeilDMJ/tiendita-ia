# Copia este archivo como .env (no se sube al repo)

# Proveedor del modelo: "nim" (NVIDIA, nube) u "ollama" (local, nada sale del equipo)
LLM_PROVIDER=nim
# Si el principal falla, probar este ("" = sin respaldo). Ej: LLM_FALLBACK=ollama
LLM_FALLBACK=

# --- NVIDIA NIM (build.nvidia.com) ---
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Ollama local (ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Ajustes
LLM_TIMEOUT_S=25
# Modelos con razonamiento (p. ej. nemotron-3.5-lightning) necesitan >= 3000
LLM_MAX_TOKENS=600
# Orígenes permitidos para CORS, separados por coma ("*" solo en desarrollo)
CORS_ORIGINS=*

# --- Base de datos (docker compose up -d db) ---
DB_NAME=tiendita
DB_USER=tiendita
DB_PASSWORD=cambia-esta-contrasena
DB_PORT=5432
# 1 = carga catálogo, lotes, ventas de ejemplo (sintéticas) al crear la BD; 0 = BD vacía
CARGAR_SEMILLA=1

# Cadena para el back y para enjambre_agentes (psycopg / SQLAlchemy / PostgresSaver de LangGraph)
DATABASE_URL=postgresql://tiendita:cambia-esta-contrasena@localhost:5432/tiendita
