# ============================================================================
# VARIABLES DE ENTORNO - Ecosistema Multiagente Comercial Multimodal
# ============================================================================
# Copia este archivo a `.env` y completa con tus credenciales reales.
# El sistema NO lee archivos de configuración personalizados, solo os.getenv().

# ── Proveedor LLM por Defecto ──────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=NVIDIA
# Opciones: NVIDIA, Gemini, Groq, Cohere, Ollama

# ── NVIDIA NIM (DGX Cloud / NGC API) ───────────────────────────────────────
# Obtén tu clave en: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Nube: https://integrate.api.nvidia.com/v1  |  NIM local (DGX Spark): http://localhost:8000/v1
# En local no hace falta NVIDIA_API_KEY. Todos los clientes NeMo usan esta URL salvo override.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── NeMo Customizer: modelo por rol (base o adaptador LoRA entrenado con SFT) ──
# Prioridad: model_name explícito > NEMO_MODEL_<ROL> > NVIDIA_REASONING_MODEL > nemotron-nano-8b.
# Solo aplica con proveedor NVIDIA. Usa el nombre con el que el NIM sirve el adaptador.
# NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NEMO_MODEL_SUPERVISOR=
# NEMO_MODEL_VENDEDOR=
# NEMO_MODEL_CONTROL=
# NEMO_MODEL_TUTOR=

# ── NeMo Retriever (embeddings + reranking para few-shot y catálogo) ─────────
NEMO_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# Debe coincidir con vector(N) en sql/*.sql
NEMO_EMBED_DIMS=1024
NEMO_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
# En local cada NIM suele ser un contenedor/puerto distinto; sin estos overrides se usa NVIDIA_BASE_URL.
# NEMO_EMBED_BASE_URL=http://localhost:8001/v1
# NEMO_RERANK_BASE_URL=http://localhost:8002/v1
# URL completa del endpoint de ranking (tiene prioridad sobre NEMO_RERANK_BASE_URL)
# NEMO_RERANK_URL=http://localhost:8002/v1/ranking
# false: solo fallbacks deterministas (sin red)
# NEMO_RETRIEVER_ENABLED=true
# Umbrales del reranker para resolve_product_hybrid (logits; ajustar con el catálogo real)
# NEMO_RERANK_MIN_LOGIT=0.0
# NEMO_RERANK_MIN_GAP=1.0

# ── NIM Vision (imagen cruda -> vision_payload) ──────────────────────────────
# Vacío: usa NVIDIA_BASE_URL
# NIM_VISION_URL=http://localhost:8003/v1
# NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# ── NeMo Guardrails (capa declarativa opcional; instalar: uv sync --extra guardrails) ──
# Las reglas deterministas de guards.py están siempre activas, con o sin esto.
NEMO_GUARDRAILS_ENABLED=false

# ── Data Flywheel (HITL -> dataset SFT para NeMo Customizer) ─────────────────
# Sin DATABASE_URL (o si falla) los registros van a este buffer JSONL local.
# NEMO_FLYWHEEL_BUFFER=datasets/hitl_feedback.jsonl

# ── Google Gemini ──────────────────────────────────────────────────────────
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # Alias alternativo

# ── Groq Cloud ─────────────────────────────────────────────────────────────
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Cohere ─────────────────────────────────────────────────────────────────
# Obtén tu clave en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# CO_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # Alias alternativo

# ── Ollama Local ───────────────────────────────────────────────────────────
# Si ejecutas Ollama en local, especifica la URL del servidor
OLLAMA_HOST=http://127.0.0.1:11434

# ── PostgreSQL (Opcional para producción) ──────────────────────────────────
# Si quieres usar PostgreSQL real en lugar del mock in-memory:
# Con DATABASE_URL se activan pgvector + reranking en few-shots y el flywheel sobre PostgreSQL.
# Requiere la extensión pgvector. Inicializar:  uv run python few_shot_retriever.py init-db && uv run python few_shot_retriever.py seed
# DATABASE_URL=postgresql://usuario:password@localhost:5432/tiendita_ia

# ── Tavily Search (Investigador de Mercado) ────────────────────────────────
# Obtén tu clave en: https://tavily.com/
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── API REST (FastAPI) ─────────────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=true
