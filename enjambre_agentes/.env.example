# ============================================================================
# VARIABLES DE ENTORNO - Ecosistema Multiagente Comercial Multimodal
# ============================================================================
# Copia este archivo a `.env` y completa con tus credenciales reales.
# El sistema NO lee archivos de configuración personalizados, solo os.getenv().

# ── Proveedor LLM por Defecto ──────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=NVIDIA
# Opciones: NVIDIA, Gemini, Groq, Cohere, Ollama

# ── NVIDIA NIM (DGX Cloud / NGC API) ───────────────────────────────────────
# Obtén tu clave en: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Google Gemini ──────────────────────────────────────────────────────────
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # Alias alternativo

# ── Groq Cloud ─────────────────────────────────────────────────────────────
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Cohere ─────────────────────────────────────────────────────────────────
# Obtén tu clave en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# CO_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # Alias alternativo

# ── Ollama Local ───────────────────────────────────────────────────────────
# Si ejecutas Ollama en local, especifica la URL del servidor
OLLAMA_HOST=http://127.0.0.1:11434

# ── PostgreSQL (Opcional para producción) ──────────────────────────────────
# Si quieres usar PostgreSQL real en lugar del mock in-memory:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/tiendita_ia

# ── Tavily Search (Investigador de Mercado) ────────────────────────────────
# Obtén tu clave en: https://tavily.com/
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── API REST (FastAPI) ─────────────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=true
