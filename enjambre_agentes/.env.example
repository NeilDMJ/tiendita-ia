# ==========================================
# Tiendita IA - Variables de Entorno
# ==========================================

# NVIDIA NIM / NeMo
NVIDIA_API_KEY=tu_nvidia_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Base de Datos PostgreSQL Vectorial
DATABASE_URL=postgresql+asyncpg://tiendita_user:tiendita_pass@localhost:5432/tiendita_db

# Búsqueda Web Tavily (Investigador)
TAVILY_API_KEY=tu_tavily_api_key_aqui
TAVILY_MAX_RESULTS=5

# HuggingFace (Modelos y Embeddings Locales/Hub)
HF_TOKEN=tu_hf_token_aqui

# Proveedores de LLM Nube
GEMINI_API_KEY=tu_gemini_api_key_aqui
GROQ_API_KEY=tu_groq_api_key_aqui
COHERE_API_KEY=tu_cohere_api_key_aqui

# LLM Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# LangSmith Observabilidad (Opcional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tiendita-ia

# Servidor API / Red LAN y Túnel SSH Nativo (Sin dependencias externas)
API_HOST=0.0.0.0
API_PORT=8000
TIENDITA_API_KEY=
SSH_VPS_TARGET=
